{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build" },
    { "src": "gateway/index.js", "use": "@vercel/node" },
    { "src": "location-service/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/gateway/(.*)", "dest": "gateway/index.js" },
    { "src": "/api/location/(.*)", "dest": "location-service/index.js" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
